# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace files
go.work
go.work.sum

# Environment files
.env
.env.*

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
# The build output is ignored, except a placeholder that main.go's go:embed needs.
frontend/dist/*
!frontend/dist/.gitkeep
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Wails
# ---------------------------------------------------------------------------
# Build output and the platform files `wails build` generates. Only the brand icons
# (copied from assets/brand/icon) are committed.
build/*
!build/appicon.png
!build/windows/
build/windows/*
!build/windows/icon.ico
frontend/package.json.md5
frontend/wailsjs/runtime/
# Generated bindings are regenerated by `wails dev` / `wails build`.
frontend/wailsjs/go/

# ---------------------------------------------------------------------------
# Local data (never commit sessions, databases or messages)
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------------------
# Tool caches (e.g. fonts downloaded by scripts/brand/generate.py)
# ---------------------------------------------------------------------------
.cache/
