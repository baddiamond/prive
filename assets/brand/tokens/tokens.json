{
  "$description": "Privé design tokens. Source of truth for colors, type, shape and motion. Regenerate derived files with: python3 scripts/brand/generate.py",
  "color": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F8F8FA",
      "100": "#ECEDF0",
      "200": "#E3E4E9",
      "300": "#A0A3AD",
      "400": "#868A95",
      "500": "#6B6F7A",
      "600": "#585C67",
      "700": "#3A3E48",
      "800": "#22252C",
      "850": "#1B1D23",
      "900": "#131418",
      "950": "#0F1013",
      "1000": "#0A0B0D"
    },
    "lavender": {
      "100": "#E4E8FF",
      "400": "#8B9CFF",
      "600": "#4453D6",
      "900": "#262C52"
    },
    "account": {
      "green":  { "dark": "#3FB68B", "light": "#1A7D5A" },
      "amber":  { "dark": "#E0A43A", "light": "#976209" },
      "rose":   { "dark": "#D46A9A", "light": "#B4477A" },
      "sky":    { "dark": "#4AA3DF", "light": "#1F78B4" },
      "violet": { "dark": "#9C8CFF", "light": "#6B5AE0" },
      "coral":  { "dark": "#E5765C", "light": "#C2533A" }
    },
    "status": {
      "success": { "dark": "#5ED3B5", "light": "#1A7D5A" },
      "warning": { "dark": "#F2A65A", "light": "#976209" },
      "danger":  { "dark": "#F2A0A8", "light": "#B3261E" }
    }
  },
  "theme": {
    "dark": {
      "bg": "#0F1013",
      "rail": "#0A0B0D",
      "surface": "#131418",
      "raised": "#1B1D23",
      "divider": "#22252C",
      "border": "#6B6F7A",
      "text": "#ECEDF0",
      "textSecondary": "#A0A3AD",
      "textFaint": "#868A95",
      "accent": "#8B9CFF",
      "onAccent": "#0A0B0D",
      "accentTint": "#262C52",
      "focus": "#8B9CFF",
      "onAccountColor": "#0A0B0D",
      "scrim": "rgba(5, 6, 8, 0.6)",
      "qrPaper": "#FFFFFF",
      "qrInk": "#0F1013",
      "qrAccent": "#4453D6"
    },
    "light": {
      "bg": "#FFFFFF",
      "rail": "#F8F8FA",
      "surface": "#F8F8FA",
      "raised": "#ECEDF0",
      "divider": "#E3E4E9",
      "border": "#6B6F7A",
      "text": "#0F1013",
      "textSecondary": "#585C67",
      "textFaint": "#6B6F7A",
      "accent": "#4453D6",
      "onAccent": "#FFFFFF",
      "accentTint": "#E4E8FF",
      "focus": "#4453D6",
      "onAccountColor": "#FFFFFF",
      "scrim": "rgba(15, 16, 19, 0.35)",
      "qrPaper": "#FFFFFF",
      "qrInk": "#0F1013",
      "qrAccent": "#4453D6"
    }
  },
  "font": {
    "sans": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "fontSize": {
    "micro": "0.6875rem",
    "caption": "0.75rem",
    "body": "0.875rem",
    "bodyStrong": "0.9375rem",
    "heading": "1.125rem",
    "title": "1.5rem",
    "display": "2rem"
  },
  "radius": {
    "tag": "6px",
    "control": "10px",
    "card": "14px",
    "bubble": "16px",
    "dialog": "20px",
    "full": "9999px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "contrastChecks": [
    { "fg": "theme.light.qrInk", "bg": "theme.light.qrPaper", "min": 7 },
    { "fg": "theme.light.qrAccent", "bg": "theme.light.qrPaper", "min": 4.5 },
    { "fg": "theme.dark.text", "bg": "theme.dark.bg", "min": 4.5 },
    { "fg": "theme.dark.textSecondary", "bg": "theme.dark.bg", "min": 4.5 },
    { "fg": "theme.dark.textSecondary", "bg": "theme.dark.surface", "min": 4.5 },
    { "fg": "theme.dark.textFaint", "bg": "theme.dark.bg", "min": 4.5 },
    { "fg": "theme.dark.textFaint", "bg": "theme.dark.surface", "min": 4.5 },
    { "fg": "theme.dark.accent", "bg": "theme.dark.bg", "min": 4.5 },
    { "fg": "theme.dark.onAccent", "bg": "theme.dark.accent", "min": 4.5 },
    { "fg": "theme.dark.border", "bg": "theme.dark.bg", "min": 3.0 },
    { "fg": "theme.dark.border", "bg": "theme.dark.raised", "min": 3.0 },
    { "fg": "theme.dark.focus", "bg": "theme.dark.surface", "min": 3.0 },
    { "fg": "theme.light.text", "bg": "theme.light.bg", "min": 4.5 },
    { "fg": "theme.light.textSecondary", "bg": "theme.light.bg", "min": 4.5 },
    { "fg": "theme.light.textSecondary", "bg": "theme.light.surface", "min": 4.5 },
    { "fg": "theme.light.textFaint", "bg": "theme.light.bg", "min": 4.5 },
    { "fg": "theme.light.textFaint", "bg": "theme.light.surface", "min": 4.5 },
    { "fg": "theme.light.accent", "bg": "theme.light.bg", "min": 4.5 },
    { "fg": "theme.light.onAccent", "bg": "theme.light.accent", "min": 4.5 },
    { "fg": "theme.light.border", "bg": "theme.light.bg", "min": 3.0 },
    { "fg": "theme.light.border", "bg": "theme.light.raised", "min": 3.0 },
    { "fg": "theme.light.focus", "bg": "theme.light.surface", "min": 3.0 }
  ]
}
